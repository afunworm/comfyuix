# ── Server ────────────────────────────────────────────────────────────────────
PORT=8888
JWT_SECRET=replace-with-a-long-random-secret
DB_PATH=/app/data/db.sqlite

# ── SMTP ──────────────────────────────────────────────────────────────────────
# Any standard SMTP provider works. Common settings:
#   Fastmail:  smtp.fastmail.com  port 587  SMTP_SECURE=false
#   Gmail:     smtp.gmail.com     port 587  SMTP_SECURE=false  (use an App Password)
#   Outlook:   smtp.office365.com port 587  SMTP_SECURE=false
#   SSL:       any host           port 465  SMTP_SECURE=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Your App Name <you@example.com>"

# ── URLs ──────────────────────────────────────────────────────────────────────
# APP_URL is used in email links (verify email, magic link, password reset).
# SERVER_URL is the backend URL (e.g. http://localhost:8888).
# Set this to the public URL where the frontend is served.
APP_URL=http://localhost
SERVER_URL=http://comfyuix_server:8888
