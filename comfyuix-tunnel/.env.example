# Required: URL of your ComfyUIX server (with or without protocol, no trailing slash)
COMFYUIX_SERVER_URL=https://yourserver.com

# Required: tunnel token from the server settings page
COMFYUIX_TOKEN=your_64_char_hex_token_here

# Optional: ComfyUI host/port (defaults shown)
# On Windows/macOS Docker Desktop, use host.docker.internal instead of 127.0.0.1
COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# Optional: path to ComfyUI models directory (defaults shown)
# On Windows/macOS Docker Desktop, use the full host path or mount a volume
MODELS_PATH=/root/ComfyUI/models
